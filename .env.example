# Example environment variables
PYTHONUNBUFFERED=1
LAYOUT_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_URL=http://127.0.0.1:8002
OCR_ASYNC_ENABLED=false
OCR_JOB_HTTP_TIMEOUT_SECONDS=30
OCR_JOB_POLL_INTERVAL_SECONDS=5
OCR_JOB_STALL_TIMEOUT_SECONDS=600
OCR_JOB_MAX_RUNTIME_SECONDS=0

# Optional. If unset, visual blocks stay pending.
# VISION_SERVICE_URL=http://127.0.0.1:8006

# Used by services/vision_llama.
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_TIMEOUT_SECONDS=1200
LLAMA_MAX_TOKENS=512
LLAMA_TEMPERATURE=0.1

# Used by docker-compose.vision-cpu.yml.
LLAMA_SERVER_PORT=8080
LLAMA_MODEL_PATH=/models/vision/qwen3.6-27b/Qwen3.6-27B-Q4_K_M.gguf
LLAMA_MMPROJ_PATH=/models/vision/qwen3.6-27b/mmproj-F16.gguf
LLAMA_CONTEXT_SIZE=4096
LLAMA_THREADS=16
